# Copy to .env.local and fill in. Never commit .env.local.

# "entra" for real sign-in, "mock" for local development without a tenant (refused in production builds).
VITE_AUTH_MODE=entra

# Entra ID — values from the app registrations (see docs/AUTH.md)
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Workforce tenant: https://login.microsoftonline.com/<tenant-id>
# External ID tenant: https://<subdomain>.ciamlogin.com/
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/
# Scope exposed by the wellbore-api registration
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/Surveys.ReadWrite

# Backend base URL. Leave empty to run with the bundled sample data only.
VITE_API_BASE_URL=

# Role used when VITE_AUTH_MODE=mock: Wellbore.Viewer | Wellbore.Engineer | Wellbore.Admin
VITE_MOCK_ROLE=Wellbore.Engineer
